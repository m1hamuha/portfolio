  },
  "comeback": {
    "enabled": false
  },
  "whatsapp": {
    "mode": "api",
    "provider": "360dialog",
    "_why": "Coexistence through a partner keeps the practice number in the WhatsApp Business app, so patients' replies land there.",
    "templates": {
      "reminder_day_before": {
        "name": "termin_erinnerung",
        "params": [
          "date",
          "time"
        ]
      }
    }
  },
  "_note": "No names of treatments, doctors' specialities or diagnoses in calendar titles or messages. Only patients with written consent (Contacts sheet column 'WhatsApp OK')."
