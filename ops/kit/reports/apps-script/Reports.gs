/* reports kit: Apps Script glue. Lives in a script bound to the CLIENT's Google Sheet
   (Extensions > Apps Script), next to ReportsCore.gs (copy of lib/ReportsCore.gs) and Config.gs.
   Config.gs is generated by `node bin/config-gs.mjs examples/<client>.json` and contains `var CONFIG = {...}`.
   Secrets (only for kind=reorder with till.type=zettle): Script Property ZETTLE_API_KEY, ZETTLE_CLIENT_ID.
   Run setup() once from the editor. Everything after that runs on triggers. */

var TAB = {
  ru: { answers: "Ответы", sum: "Итоги", items: "Товары", deliv: "Привоз", invoices: "Счета", sales: "Продажи", bank: "Выписка", rules: "Правила", month: "Месяц", other: "Доходы и расходы" },
  uk: { answers: "Відповіді", sum: "Підсумки", items: "Товари", deliv: "Привіз", invoices: "Рахунки", sales: "Продажі", bank: "Виписка", rules: "Правила", month: "Місяць", other: "Доходи і витрати" },
  de: { answers: "Antworten", sum: "Übersicht", items: "Artikel", deliv: "Lieferungen", invoices: "Rechnungen", sales: "Verkäufe", bank: "Kontoauszug", rules: "Regeln", month: "Monat", other: "Einnahmen und Ausgaben" },
  en: { answers: "Answers", sum: "Totals", items: "Items", deliv: "Deliveries", invoices: "Invoices", sales: "Sales", bank: "Statement", rules: "Rules", month: "Month", other: "Income and costs" }
};

/* Form question titles. The responses sheet uses them as column headers, so code reads columns by these titles. */
var Q = {
  ru: { name: "Твоё имя", job: "Объект", date: "Дата", start: "Начало", end: "Конец", pause: "Перерыв, минут",
        client: "Клиент", cash: "Наличные от клиента, €", spent: "Потратила на химию и прочее, €", handed: "Отдала владельцу, €",
        left: "Осталось: {item} ({unit})", got: "Привезли: {item} ({unit})", had_delivery: "Сегодня был привоз?", yes: "Да", no: "Нет", note: "Комментарий" },
  uk: { name: "Твоє ім'я", job: "Об'єкт", date: "Дата", start: "Початок", end: "Кінець", pause: "Перерва, хвилин",
        client: "Клієнт", cash: "Готівка від клієнта, €", spent: "Витратила на засоби та інше, €", handed: "Віддала власнику, €",
        left: "Залишилось: {item} ({unit})", got: "Привезли: {item} ({unit})", had_delivery: "Сьогодні був привіз?", yes: "Так", no: "Ні", note: "Коментар" },
  de: { name: "Dein Name", job: "Baustelle / Objekt", date: "Datum", start: "Beginn", end: "Ende", pause: "Pause, Minuten",
        client: "Kunde", cash: "Bargeld vom Kunden, €", spent: "Ausgegeben für Material, €", handed: "An Chef abgegeben, €",
        left: "Übrig: {item} ({unit})", got: "Geliefert: {item} ({unit})", had_delivery: "Gab es heute eine Lieferung?", yes: "Ja", no: "Nein", note: "Kommentar" },
  en: { name: "Your name", job: "Job / site", date: "Date", start: "Start", end: "End", pause: "Break, minutes",
        client: "Client", cash: "Cash from client, €", spent: "Spent on supplies, €", handed: "Handed to owner, €",
        left: "Left: {item} ({unit})", got: "Delivered: {item} ({unit})", had_delivery: "Was there a delivery today?", yes: "Yes", no: "No", note: "Note" }
};

function cfg_() { return CONFIG; }
function lang_() { return cfg_().lang || "ru"; }
function tab_(k) { return TAB[lang_()][k]; }
function q_(k, vars) { return fill(Q[lang_()][k], vars || {}); }
function props_() { return PropertiesService.getScriptProperties(); }

function sheet_(name, header) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sh = ss.getSheetByName(name) || ss.insertSheet(name);
  if (header && sh.getLastRow() === 0) { sh.appendRow(header); sh.setFrozenRows(1); }
  return sh;
}

/* rows as objects keyed by header text */
function readTable_(name) {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName(name);
  if (!sh || sh.getLastRow() < 2) return [];
  var v = sh.getDataRange().getValues();
  var head = v[0].map(String);
  return v.slice(1).filter(function (r) { return r.join("") !== ""; }).map(function (r) {
    var o = {}; head.forEach(function (h, i) { o[h] = r[i]; }); return o;
  });
}

function writeBlock_(name, rows) {
  var sh = sheet_(name);
  sh.clear();
  if (!rows.length) return sh;
  var w = rows.reduce(function (a, r) { return Math.max(a, r.length); }, 1);
  var padded = rows.map(function (r) { var c = r.slice(); while (c.length < w) c.push(""); return c; });
  sh.getRange(1, 1, padded.length, w).setValues(padded);
  return sh;
}

function todayIso_() { return isoDate(new Date()); }

/* ---------- setup ---------- */

function setup() {
  var cfg = cfg_();
  var errs = validateReportConfig(cfg);
  if (errs.length) throw new Error("CONFIG: " + errs.join("; "));
  ScriptApp.getProjectTriggers().forEach(function (t) { ScriptApp.deleteTrigger(t); });
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var made = {};
  if (cfg.kind === "stock" || cfg.kind === "hours" || cfg.kind === "cash") {
    var form = buildForm_(cfg);
    form.setDestination(FormApp.DestinationType.SPREADSHEET, ss.getId());
    SpreadsheetApp.flush();
    ss.getSheets().forEach(function (s) { if (s.getFormUrl && s.getFormUrl()) s.setName(tab_("answers")); });
    props_().setProperty("FORM_ID", form.getId());
    made.form_url = form.getPublishedUrl();
    ScriptApp.newTrigger("refresh").forSpreadsheet(ss).onFormSubmit().create();
    ScriptApp.newTrigger("weekly").timeBased().onWeekDay(ScriptApp.WeekDay.MONDAY).atHour(7).create();
  }
  if (cfg.kind === "stock") {
    sheet_(tab_("items"), ["id", "name", "unit", "price", "plan_week"]);
    cfg.items.forEach(function (it) { sheet_(tab_("items")).appendRow([it.id, it.name, it.unit, it.price, it.plan_week]); });
  }
  if (cfg.kind === "cash") {
    sheet_(tab_("other"), ["date", "type (in/out)", "amount", "what"]);
  }
  if (cfg.kind === "receivables") {
    var sh = sheet_(tab_("invoices"), ["no", "client", "phone", "lang", "amount", "issued", "due", "paid", "late_days", "reminder", "whatsapp"]);
    sh.getRange("H2:H500").insertCheckboxes();
    var red = SpreadsheetApp.newConditionalFormatRule().whenFormulaSatisfied("=AND($A2<>\"\",$H2=FALSE,$G2<TODAY())")
      .setBackground("#f4c7c3").setRanges([sh.getRange("A2:K500")]).build();
    sh.setConditionalFormatRules([red]);
    ScriptApp.newTrigger("refresh").forSpreadsheet(ss).onEdit().create();
    ScriptApp.newTrigger("refresh").timeBased().everyDays(1).atHour(6).create();
  }
  if (cfg.kind === "reorder") {
    sheet_(tab_("items"), ["sku", "name", "supplier", "pack", "min", "cover_days", "stock", "counted", "counted_at"]);
    sheet_(tab_("sales"), ["date", "sku", "qty", "receipt"]);
    sheet_(tab_("deliv"), ["date", "sku", "qty"]);
    ScriptApp.newTrigger("importTill").timeBased().everyDays(1).atHour(3).create();
    ScriptApp.newTrigger("weekly").timeBased().onWeekDay(ScriptApp.WeekDay.MONDAY).atHour(7).create();
  }
  if (cfg.kind === "monthly") {
    sheet_(tab_("bank"), ["date", "amount", "payee", "purpose", "cat"]);
    var rs = sheet_(tab_("rules"), ["cat", "words (comma)", "sign (in/out/any)"]);
    if (rs.getLastRow() === 1) cfg.rules.forEach(function (r) { rs.appendRow([r.cat, (r.any || []).join(", "), r.sign || "any"]); });
    ScriptApp.newTrigger("monthly").timeBased().onMonthDay(cfg.send_day || 3).atHour(7).create();
  }
  sheet_(tab_("sum"));
  refresh();
  return made;
}

function buildForm_(cfg) {
  var form = FormApp.create(cfg.business.name + " " + ({ stock: "closing", hours: "hours", cash: "cash" })[cfg.kind]);
  form.setCollectEmail(false);
  form.setLimitOneResponsePerUser(false); // no Google login needed for staff
  form.setDescription(cfg.form_note || "");
  if (cfg.kind === "stock") {
    form.addListItem().setTitle(q_("name")).setChoiceValues(cfg.staff || ["-"]).setRequired(true);
    cfg.items.forEach(function (it) {
      form.addTextItem().setTitle(q_("left", { item: it.name, unit: it.unit })).setRequired(true)
        .setValidation(FormApp.createTextValidation().requireNumber().build());
    });
    var ask = form.addMultipleChoiceItem().setTitle(q_("had_delivery")).setRequired(true);
    var page2 = form.addPageBreakItem().setTitle(q_("got", { item: "", unit: "" }).replace(/[:()\s]+$/, ""));
    ask.setChoices([ask.createChoice(q_("yes"), page2), ask.createChoice(q_("no"), FormApp.PageNavigationType.SUBMIT)]);
    cfg.items.forEach(function (it) {
      form.addTextItem().setTitle(q_("got", { item: it.name, unit: it.unit }))
        .setValidation(FormApp.createTextValidation().requireNumber().build());
    });
  }
  if (cfg.kind === "hours") {
    form.addListItem().setTitle(q_("name")).setChoiceValues(cfg.workers).setRequired(true);
    form.addListItem().setTitle(q_("job")).setChoiceValues(cfg.jobs).setRequired(true);
    form.addDateItem().setTitle(q_("date")).setRequired(true);
    form.addTimeItem().setTitle(q_("start")).setRequired(true);
    form.addTimeItem().setTitle(q_("end")).setRequired(true);
    form.addTextItem().setTitle(q_("pause")).setValidation(FormApp.createTextValidation().requireNumber().build());
  }
  if (cfg.kind === "cash") {
    form.addListItem().setTitle(q_("name")).setChoiceValues(cfg.cleaners).setRequired(true);
    form.addDateItem().setTitle(q_("date")).setRequired(true);
    form.addTextItem().setTitle(q_("client"));
    ["cash", "spent", "handed"].forEach(function (k) {
      form.addTextItem().setTitle(q_(k)).setValidation(FormApp.createTextValidation().requireNumber().build());
    });
    form.addParagraphTextItem().setTitle(q_("note"));
  }
  return openForm_(form);
}

/* Make sure applicants / staff can answer without a Google login. Newer FormApp versions can create a form
   unpublished (create(title, isPublished)); a Google Workspace domain may restrict forms to its own users. */
function openForm_(form) {
  try { if (typeof form.isPublished === "function" && !form.isPublished()) form.setPublished(true); } catch (e) { console.warn("setPublished: " + e); }
  try { if (typeof form.setRequireLogin === "function") form.setRequireLogin(false); } catch (e) { console.warn("setRequireLogin: " + e); }
  try { if (typeof form.setAcceptingResponses === "function") form.setAcceptingResponses(true); } catch (e) { console.warn("setAcceptingResponses: " + e); }
  return form;
}

/* ---------- recompute the totals tab (on every form answer / edit / daily) ---------- */

function refresh() {
  var cfg = cfg_(), L = lang_();
  var today = todayIso_();
  if (cfg.kind === "stock") {
    var ans = readTable_(tab_("answers"));
    var counts = [], deliv = [];
    ans.forEach(function (a) {
      var d = isoDate(a["Timestamp"] || a["Отметка времени"] || a["Zeitstempel"] || a[Object.keys(a)[0]]);
      cfg.items.forEach(function (it) {
        var left = a[q_("left", { item: it.name, unit: it.unit })];
        if (left !== "" && left !== undefined) counts.push({ date: d, item: it.id, left: left });
        var got = a[q_("got", { item: it.name, unit: it.unit })];
        if (got !== "" && got !== undefined) deliv.push({ date: d, item: it.id, qty: got });
      });
    });
    readTable_(tab_("deliv")).forEach(function (r) { deliv.push({ date: r.date, item: r.item || r.id, qty: r.qty }); });
    var items = readTable_(tab_("items"));
    if (!items.length) items = cfg.items;
    var wk = lastWeek(today);
    var thisWeek = { from: addDays(wk.to, 1), to: today };
    var a1 = stockUsage(items, counts, deliv, wk.from, wk.to, cfg);
    var a2 = stockUsage(items, counts, deliv, thisWeek.from, thisWeek.to, cfg);
    var rows = [[stockReportText(a2, L)], [""], [stockReportText(a1, L)]];
    writeBlock_(tab_("sum"), rows);
    return { last: a1, current: a2 };
  }
  if (cfg.kind === "hours") {
    var rowsH = readTable_(tab_("answers")).map(function (a) {
      return { ts: a[Object.keys(a)[0]], worker: a[q_("name")], job: a[q_("job")], date: a[q_("date")], start: a[q_("start")], end: a[q_("end")], pause_min: a[q_("pause")] };
    });
    var w = lastWeek(today);
    var cur = hoursSummary(rowsH, addDays(w.to, 1), today);
    var prev = hoursSummary(rowsH, w.from, w.to);
    var mk = monthKey(today);
    var month = hoursSummary(rowsH, mk + "-01", today);
    var out = [[hoursReportText(cur, L)], [""], [hoursReportText(prev, L)], [""], ["month " + mk]];
    month.jobs.forEach(function (j) { j.by_worker.forEach(function (b) { out.push([j.job, b.worker, b.hours]); }); });
    writeBlock_(tab_("sum"), out);
    return { current: cur, previous: prev, month: month };
  }
  if (cfg.kind === "cash") {
    var entries = readTable_(tab_("answers")).map(function (a) {
      return { date: a[q_("date")], cleaner: a[q_("name")], client: a[q_("client")], cash: a[q_("cash")], spent: a[q_("spent")], handed: a[q_("handed")] };
    });
    var other = { income: [], costs: [] };
    readTable_(tab_("other")).forEach(function (r) {
      var t = String(r["type (in/out)"]).toLowerCase();
      (t === "in" ? other.income : other.costs).push({ date: r.date, amount: r.amount, what: r.what });
    });
    var led = cashLedger(entries, monthKey(today), { wages: cfg.wages, fixed: cfg.fixed }, other);
    var tbl = [["", "cash", "spent", "handed", "owes"]].concat(led.people.map(function (p) { return [p.cleaner, p.cash, p.spent, p.handed, p.owes]; }));
    tbl.push([""], [ledgerText(led, L)]);
    writeBlock_(tab_("sum"), tbl);
    return led;
  }
  if (cfg.kind === "receivables") {
    var sh = sheet_(tab_("invoices"));
    var v = sh.getDataRange().getValues();
    var invs = v.slice(1).filter(function (r) { return r[0] !== ""; }).map(function (r) {
      return { no: r[0], client: r[1], phone: r[2], lang: r[3] || cfg.customer_lang || "de", amount: r[4], issued: r[5] || "", due: r[6], paid: r[7] };
    });
    var rec = receivables(invs, today, { stages: cfg.stages });
    rec.rows.forEach(function (row, i) {
      var text = reminderText(row, cfg.business.sign || cfg.business.name, today);
      var link = text && row.phone ? waLink(row.phone, text, cfg.country_code || "49") : "";
      sh.getRange(i + 2, 9, 1, 3).setValues([[row.paid ? "" : row.late, text, link]]);
    });
    writeBlock_(tab_("sum"), [["open", rec.open_total], ["overdue", rec.overdue_total], ["due this month", rec.due_this_month]]);
    return rec;
  }
  if (cfg.kind === "reorder") {
    var r = reorderNow_();
    writeBlock_(tab_("sum"), [[reorderText(r, L)]]);
    return r;
  }
  if (cfg.kind === "monthly") {
    return monthly(true);
  }
}

function weekly() {
  var cfg = cfg_(), L = lang_();
  var res = refresh();
  if (!cfg.owner_email) return res;
  var text;
  if (cfg.kind === "stock") text = stockReportText(res.last, L);
  else if (cfg.kind === "hours") text = hoursReportText(res.previous, L);
  else if (cfg.kind === "cash") text = ledgerText(res, L);
  else if (cfg.kind === "reorder") text = reorderText(res, L);
  else return res;
  MailApp.sendEmail(cfg.owner_email, cfg.business.name + ": " + text.split("\n")[0], text + "\n\n" + SpreadsheetApp.getActiveSpreadsheet().getUrl());
  return res;
}

/* ---------- shop: till import ---------- */

function reorderNow_() {
  var cfg = cfg_();
  var items = readTable_(tab_("items"));
  var sales = readTable_(tab_("sales"));
  var deliv = readTable_(tab_("deliv"));
  return reorderList(stockFromCount(items, sales, deliv), sales, todayIso_(), cfg.reorder || {});
}

function importTill() {
  var cfg = cfg_(), till = cfg.till;
  var rows = [], zTo = null;
  if (till.type === "csv_drive") {
    /* every file not seen before (a till can drop several per day); duplicate rows are skipped below */
    var it = DriveApp.getFolderById(till.folder_id).getFiles();
    while (it.hasNext()) {
      var f = it.next();
      if (props_().getProperty("TILL_" + f.getId())) continue;
      rows = rows.concat(csvToObjects(f.getBlob().getDataAsString(till.encoding || "UTF-8"), till.map, till.delimiter));
      props_().setProperty("TILL_" + f.getId(), "1");
    }
  } else if (till.type === "csv_mail") {
    var threads = GmailApp.search("from:(" + till.from + ") has:attachment newer_than:3d", 0, 5);
    threads.forEach(function (t) {
      t.getMessages().forEach(function (m) {
        if (props_().getProperty("MSG_" + m.getId())) return;
        m.getAttachments().forEach(function (a) {
          if (!/\.csv$/i.test(a.getName())) return;
          rows = rows.concat(csvToObjects(a.getDataAsString(till.encoding || "UTF-8"), till.map, till.delimiter));
        });
        props_().setProperty("MSG_" + m.getId(), "1");
      });
    });
  } else if (till.type === "zettle") {
    /* from the last day that worked (a failed night is caught up), overlap of one day, duplicates removed by receipt id */
    var zFrom = props_().getProperty("ZETTLE_DONE_TO") || addDays(todayIso_(), -1);
    var zTo = todayIso_();
    rows = zettleFetch_(addDays(zFrom, -1), zTo);
  } else throw new Error("unknown till.type " + till.type);
  var sh = sheet_(tab_("sales"));
  var vals = rows.filter(function (r) { return r.sku && num(r.qty); }).map(function (r) { return [isoDate(r.date), String(r.sku), num(r.qty), r.id ? String(r.id) : ""]; });
  /* rows with a receipt id (Zettle) are skipped if already there; plain CSV rows only if file was seen (above) */
  var seen = keysOf_(sh, 4, function (r) { return r[3] ? String(r[3]) + "|" + r[1] : ""; });
  vals = vals.filter(function (v) { var k = v[3] ? v[3] + "|" + v[1] : ""; if (!k) return true; if (seen[k]) return false; seen[k] = 1; return true; });
  if (vals.length) sh.getRange(sh.getLastRow() + 1, 1, vals.length, 4).setValues(vals);
  if (till.type === "zettle" && zTo) props_().setProperty("ZETTLE_DONE_TO", zTo);
  return vals.length;
}

/* Zettle (PayPal POS): API key made by the shop owner in my.zettle.com, stored as Script Properties.
   Endpoints from Zettle's public docs as of 2025; developer.zettle.com was not reachable for re-check, see README. */
function zettleFetch_(from, to) {
  var p = props_();
  var tok = UrlFetchApp.fetch("https://oauth.zettle.com/token", {
    method: "post", muteHttpExceptions: true,
    payload: { grant_type: "urn:ietf:params:oauth:grant-type:jwt-bearer", client_id: p.getProperty("ZETTLE_CLIENT_ID"), assertion: p.getProperty("ZETTLE_API_KEY") }
  });
  if (tok.getResponseCode() !== 200) throw new Error("zettle token " + tok.getResponseCode());
  var access = JSON.parse(tok.getContentText()).access_token;
  var res = UrlFetchApp.fetch("https://purchase.izettle.com/purchases/v2?startDate=" + from + "&endDate=" + to + "&limit=1000", {
    headers: { Authorization: "Bearer " + access }, muteHttpExceptions: true
  });
  if (res.getResponseCode() !== 200) throw new Error("zettle purchases " + res.getResponseCode());
  return zettleToSales(JSON.parse(res.getContentText()));
}

/* ---------- other: one page a month from the bank file ---------- */

/* Bank CSV dropped into the Statement tab via File > Import, or into Drive folder cfg.bank_folder_id. */
function importBankCsv() {
  var cfg = cfg_();
  var it = DriveApp.getFolderById(cfg.bank_folder_id).getFiles();
  var sh = sheet_(tab_("bank"));
  var n = 0;
  while (it.hasNext()) {
    var f = it.next();
    if (props_().getProperty("BANK_" + f.getId())) continue;
    var rows = csvToObjects(f.getBlob().getDataAsString(cfg.bank_csv.encoding || "UTF-8"), cfg.bank_csv.map, cfg.bank_csv.delimiter);
    /* bank exports often overlap ("last 30 days"): a payment already in the tab is not added twice */
    var seen = keysOf_(sh, 4, bankKey_);
    var vals = rows.map(function (r) { return [isoDate(r.date), num(r.amount), r.payee || "", r.purpose || "", ""]; })
      .filter(function (v) { var k = bankKey_(v); if (seen[k]) return false; seen[k] = 1; return true; });
    if (vals.length) sh.getRange(sh.getLastRow() + 1, 1, vals.length, 5).setValues(vals);
    props_().setProperty("BANK_" + f.getId(), "1");
    n += vals.length;
  }
  return n;
}

function bankKey_(r) { return [isoDate(r[0]), num(r[1]).toFixed(2), String(r[2]).trim(), String(r[3]).trim()].join("|"); }

/* existing rows of a tab as a set of keys (row 1 is the header) */
function keysOf_(sh, ncols, keyFn) {
  var out = {};
  var last = sh.getLastRow();
  if (last < 2) return out;
  sh.getRange(2, 1, last - 1, ncols).getValues().forEach(function (r) { var k = keyFn(r); if (k) out[k] = 1; });
  return out;
}

function monthly(noMail) {
  var cfg = cfg_(), L = lang_();
  if (cfg.bank_folder_id) importBankCsv();
  var rules = readTable_(tab_("rules")).map(function (r) {
    return { cat: r.cat, any: String(r["words (comma)"]).split(",").map(function (s) { return s.trim(); }).filter(String), sign: r["sign (in/out/any)"] };
  });
  var tx = readTable_(tab_("bank")).map(function (r) { return { date: r.date, amount: r.amount, payee: r.payee, purpose: r.purpose }; });
  var txc = categorize(tx, rules.length ? rules : cfg.rules);
  var sh = sheet_(tab_("bank"));
  if (txc.length) sh.getRange(2, 5, txc.length, 1).setValues(txc.map(function (t) { return [t.guessed ? "? " + t.cat : t.cat]; }));
  var mk = prevMonthKey(monthKey(todayIso_())); // on the 3rd we report the month that just ended
  var sm = monthSummary(txc, mk);
  var text = onePageText(sm, L, cfg.cat_names, cfg.business.name);
  writeBlock_(tab_("month"), text.split("\n").map(function (l) { return [l]; }));
  if (!noMail && cfg.owner_email) MailApp.sendEmail(cfg.owner_email, cfg.business.name + " " + mk, text);
  return sm;
}
